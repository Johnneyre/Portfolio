---
import { TIMELINE_ITEMS } from "../data/portfolio";
import { useTranslations, sectionId } from "../i18n/utils";
import type { SupportedLocale } from "../i18n/utils";
import SectionHead from "./SectionHead.astro";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  id={sectionId(locale, "experience")}
  class="section cv-auto"
  aria-labelledby="experience-title"
  data-section="experience"
  tabindex="-1"
>
  <div class="wrap">
    <SectionHead
      number="01"
      title={t.experience.title}
      headingId="experience-title"
      label={t.experience.label}
    />

    <div class="xp-list">
      {
        TIMELINE_ITEMS.map((item, idx) => {
          const tItem = t.timeline_items[item.id as keyof typeof t.timeline_items];
          return (
            <article class={`xp grid-12 reveal reveal-delay-${Math.min(idx + 1, 3)}`}>
              <div class="xp-meta">
                <p class="xp-period">{tItem.period}</p>
                <p class="xp-org">{item.company}</p>
                <p class="xp-loc">{item.location}</p>
              </div>

              <div class="xp-body">
                <h3>
                  {tItem.role}
                  <span class="sr-only">· {item.company}</span>
                </h3>
                <ul class="bullets">
                  {tItem.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
