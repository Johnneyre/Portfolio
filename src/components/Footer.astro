---
import { useTranslations, sectionId } from "../i18n/utils";
import type { SupportedLocale } from "../i18n/utils";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const links = [
  { key: "home", label: t.footer.links.home },
  { key: "experience", label: t.footer.links.experience },
  { key: "projects", label: t.footer.links.projects },
] as const;

const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="wrap">
    <nav aria-label={t.nav.footer}>
      <ul class="foot-links">
        {
          links.map((link) => (
            <li>
              <a href={`#${sectionId(locale, link.key)}`} class="link-hover">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="copy">
      &copy; <span id="footer-year">{year}</span> {t.owner.name}
    </p>
  </div>
</footer>

<script>
  function setFooterYear(): void {
    const el = document.getElementById("footer-year");
    if (el) el.textContent = new Date().getFullYear().toString();
  }

  document.addEventListener("astro:page-load", setFooterYear);
  document.addEventListener("astro:after-swap", setFooterYear);
</script>
