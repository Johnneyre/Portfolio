---
import { useTranslations, getLocalePath, sectionId } from "../i18n/utils";
import type { SupportedLocale } from "../i18n/utils";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitcher from "./LangSwitcher.astro";
import Icon from "./Icon.astro";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const links = [
  { key: "experience", label: t.nav.experience },
  { key: "projects", label: t.nav.projects },
  { key: "skills", label: t.nav.skills },
] as const;

const initials = t.owner.name
  .split(" ")
  .map((word) => word[0])
  .join("");
---

<header class="site-head">
  <div class="wrap head-row">
    <a class="brand" href={getLocalePath(locale)} aria-label={t.owner.name}>
      <span class="brand-mark" aria-hidden="true">{initials}</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label={t.nav.primary}>
      {links.map((link) => <a href={`#${sectionId(locale, link.key)}`}>{link.label}</a>)}
    </nav>

    <div class="controls">
      <ThemeToggle label={t.nav.theme} />
      <LangSwitcher locale={locale} label={t.nav.language} />
      <button
        type="button"
        class="menu-btn"
        id="menu-toggle"
        aria-label={t.nav.menu}
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <Icon name="menu" size={22} class="menu-btn__open" />
        <Icon name="close" size={22} class="menu-btn__close" />
      </button>
    </div>
  </div>
</header>

<script>
  // window/document listeners are bound once (they survive view transitions);
  // the header and its buttons are re-queried on every astro:page-load.
  let header: HTMLElement | null = null;

  function updateHeader(): void {
    header?.classList.toggle("is-scrolled", window.scrollY > 40);
  }
  window.addEventListener("scroll", updateHeader, { passive: true });

  function setMenuOpen(open: boolean): void {
    header?.classList.toggle("is-open", open);
    document.getElementById("menu-toggle")?.setAttribute("aria-expanded", String(open));
  }

  function initMenu(): void {
    const btn = document.getElementById("menu-toggle");
    btn?.addEventListener("click", () => setMenuOpen(!header?.classList.contains("is-open")));
    document.querySelectorAll(".site-nav a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });
  }

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && header?.classList.contains("is-open")) {
      setMenuOpen(false);
      document.getElementById("menu-toggle")?.focus();
    }
  });

  document.addEventListener("click", (event) => {
    if (header?.classList.contains("is-open") && !header.contains(event.target as Node)) {
      setMenuOpen(false);
    }
  });

  let spy: IntersectionObserver | null = null;

  function initNavSpy(): void {
    spy?.disconnect();
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".site-nav a[href^='#']"));
    if (!links.length) return;

    const byId = new Map(links.map((a) => [a.getAttribute("href")!.slice(1), a]));
    const clear = (a: HTMLAnchorElement) => {
      a.classList.remove("is-active");
      a.removeAttribute("aria-current");
    };

    spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = byId.get(entry.target.id);
          if (!link) return;
          if (entry.isIntersecting) {
            links.forEach(clear);
            link.classList.add("is-active");
            link.setAttribute("aria-current", "location");
          } else if (link.classList.contains("is-active")) {
            clear(link);
          }
        });
      },
      { rootMargin: "-35% 0px -55% 0px" },
    );

    byId.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) spy!.observe(section);
    });
  }

  document.addEventListener("astro:page-load", () => {
    header = document.querySelector(".site-head");
    requestAnimationFrame(updateHeader);
    initMenu();
    initNavSpy();
  });
</script>
