---
import { Image, getImage } from "astro:assets";
import portrait from "../assets/hero/johnneyre-zambrano.jpg";
import { SOCIAL_LINKS } from "../data/portfolio";
import { useTranslations, sectionId } from "../i18n/utils";
import type { SupportedLocale } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const emailLink = SOCIAL_LINKS.find((l) => l.icon === "email")!;
const linkedinLink = SOCIAL_LINKS.find((l) => l.icon === "linkedin")!;
const githubLink = SOCIAL_LINKS.find((l) => l.icon === "github")!;

const [firstName, ...rest] = t.owner.name.split(" ");
const lastName = rest.join(" ");

// Phones: 1:1 crop of the landscape original (more context than a square cut of the 4:5).
const square = await getImage({
  src: portrait,
  width: 440,
  height: 440,
  widths: [220, 352, 440],
  fit: "cover",
  position: "attention",
  format: "avif",
  quality: 70,
});
---

<section id={sectionId(locale, "home")} class="hero" aria-labelledby="hero-name">
  <div class="wrap">
    <div class="hero-stage">
      <div class="gridlines" aria-hidden="true"></div>

      <div class="grid-12 hero-grid">
        <div class="hero-intro hero-enter-1">
          <p class="hello">{t.hero.greeting}</p>
          <!-- On phones the surname is visually hidden (still read by assistive tech). -->
          <h1 class="name" id="hero-name">{firstName}<span class="name-last"> <br />{lastName}</span></h1>
        </div>

        <div class="hero-meta hero-enter-2">
          <div class="role-block">
            <p class="role">{t.hero.role}</p>

            <ul class="social">
              <li>
                <a class="ul" href={emailLink.href}>
                  <Icon name="email" size={16} />
                  {t.social.email}
                </a>
              </li>
              <li>
                <a class="ul" href={linkedinLink.href} target="_blank" rel="me noopener">
                  <Icon name="linkedin" size={16} />
                  LinkedIn
                  <span class="sr-only">{t.a11y.new_tab}</span>
                </a>
              </li>
              <li>
                <a class="ul" href={githubLink.href} target="_blank" rel="me noopener">
                  <Icon name="github" size={16} />
                  GitHub
                  <span class="sr-only">{t.a11y.new_tab}</span>
                </a>
              </li>
            </ul>
          </div>

          <p class="bio">{t.hero.bio}</p>
        </div>

        <figure class="hero-visual hero-enter-3">
          <div class="photo">
            <!-- Only the matching <source> downloads. -->
            <picture>
              <source media="(max-width: 640px)" type="image/avif" srcset={square.srcSet.attribute} sizes="11rem" />
              <Image
                src={portrait}
                alt={`${t.owner.name} – ${t.owner.role}`}
                priority
                width={730}
                height={912}
                widths={[365, 550, 730]}
                sizes="(max-width: 1024px) 33vw, 365px"
                quality={70}
                format="avif"
              />
            </picture>
          </div>
        </figure>
      </div>
    </div>
  </div>

  <div class="scroll-cue hero-enter-4">
    <a href={`#${sectionId(locale, "experience")}`}>
      <span class="label">{t.hero.scroll_label}</span>
      <span class="bounce-y" aria-hidden="true">
        <Icon name="arrow-down" size={20} />
      </span>
    </a>
  </div>
</section>
