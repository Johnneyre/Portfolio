---
import { getLocalePath } from "../i18n/utils";
import type { SupportedLocale } from "../i18n/utils";

interface Props {
  locale: SupportedLocale;
  label: string;
}

const { locale, label } = Astro.props;

const options: readonly { code: SupportedLocale; name: string }[] = [
  { code: "es", name: "Español" },
  { code: "en", name: "English" },
];
---

<div class="lang" role="group" aria-label={label}>
  {
    options.map((lang, idx) => (
      <>
        {idx > 0 && <span aria-hidden="true">/</span>}
        <a
          href={getLocalePath(lang.code)}
          data-lang={lang.code}
          hreflang={lang.code}
          lang={lang.code}
          aria-label={lang.name}
          aria-current={lang.code === locale ? "page" : undefined}
          data-astro-prefetch
        >
          {lang.code.toUpperCase()}
        </a>
      </>
    ))
  }
</div>

<script>
  // LangHint checks this key before showing itself.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLAnchorElement>(".lang a[data-lang]").forEach((link) => {
      link.addEventListener("click", () => {
        localStorage.setItem("lang", link.dataset.lang!);
      });
    });
  });
</script>
