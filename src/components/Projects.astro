---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PROJECT_ITEMS } from '../data/portfolio';
import { useTranslations, sectionId } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/utils';
import Icon from './Icon.astro';
import ProjectLink from './ProjectLink.astro';
import SectionHead from './SectionHead.astro';
import TechLogo from './TechLogo.astro';
import TechStack from './TechStack.astro';
import webgpuImg from '../assets/projects/image-optimize-webgpu.png';
import trandioImg from '../assets/projects/trandio.png';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const PROJECT_IMAGES: Record<string, ImageMetadata> = {
  'image-optimize-webgpu': webgpuImg,
  trandio: trandioImg,
};
---

<section
  id={sectionId(locale, 'projects')}
  class="section cv-auto"
  aria-labelledby="projects-title"
  data-section="projects"
  tabindex="-1"
>
  <div class="wrap">
    <SectionHead number="02" title={t.projects.title} headingId="projects-title" label={t.projects.label} />

    <div class="proj-list">
      {PROJECT_ITEMS.map((project) => {
        const tItem = t.project_items[project.id as keyof typeof t.project_items];
        const image = PROJECT_IMAGES[project.id];
        const hasLinks = Boolean(project.liveUrl || project.repoUrl);
        // Cover link is mouse-only; keyboard and AT use the "demo" button below.
        const CoverTag = project.liveUrl ? 'a' : 'div';
        const coverProps = project.liveUrl
          ? { href: project.liveUrl, target: '_blank', rel: 'noopener', tabindex: '-1', 'aria-hidden': 'true' }
          : {};
        return (
          <article class="proj grid-12 reveal">
            {image ? (
              <CoverTag class="proj-media" {...coverProps}>
                <Image
                  src={image}
                  alt={t.projects.screenshot_alt.replace('{title}', tItem.title)}
                  width={1200}
                  height={750}
                  widths={[640, 960, 1200]}
                  sizes="(max-width: 640px) 90vw, (max-width: 1024px) 66vw, 50vw"
                  quality="high"
                  format="avif"
                  loading="lazy"
                />
              </CoverTag>
            ) : (
              <div class="proj-media proj-media--gen" style={`--accent-h: ${project.accent ?? 159}`} aria-hidden="true">
                <div class="proj-gen">
                  {project.concept && <Icon name={project.concept} size={40} class="proj-gen__concept" />}
                  <span class="proj-gen__title">{tItem.title}</span>
                  <div class="proj-gen__logos">
                    {project.tags.map((tag) => (
                      <TechLogo id={tag.id} size={26} />
                    ))}
                  </div>
                </div>
              </div>
            )}

            <div class="proj-text">
              <h3 class="proj-title">{tItem.title}</h3>
              <p class="proj-desc">{tItem.description}</p>

              <ul class="bullets">
                {tItem.highlights.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>

              <div class="proj-tech">
                <p class="label">{t.projects.stack}</p>
                <TechStack tags={project.tags} locale={locale} />
              </div>

              {hasLinks && (
                <div class="proj-links">
                  {project.liveUrl && (
                    <ProjectLink
                      href={project.liveUrl}
                      icon="globe"
                      label={t.projects.demo}
                      title={tItem.title}
                      newTabLabel={t.a11y.new_tab}
                    />
                  )}
                  {project.repoUrl && (
                    <ProjectLink
                      href={project.repoUrl}
                      icon="github"
                      label={t.projects.code}
                      title={tItem.title}
                      newTabLabel={t.a11y.new_tab}
                    />
                  )}
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
