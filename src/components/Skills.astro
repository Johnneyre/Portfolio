---
import { SKILL_CATEGORIES } from '../data/portfolio';
import { useTranslations, sectionId } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/utils';
import SectionHead from './SectionHead.astro';
import TechLogo from './TechLogo.astro';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  id={sectionId(locale, 'skills')}
  class="section cv-auto"
  aria-labelledby="skills-title"
  data-section="skills"
  tabindex="-1"
>
  <div class="wrap">
    <SectionHead number="03" title={t.skills.title} headingId="skills-title" lead={t.skills.subtitle} />

    <div class="skills grid-12">
      {SKILL_CATEGORIES.map((category, catIdx) => {
        const categoryLabel = t.skill_categories[category.id as keyof typeof t.skill_categories];
        return (
          <div class={`skill-col reveal reveal-delay-${Math.min(catIdx + 1, 3)}`}>
            <h3>{categoryLabel}</h3>
            <ul>
              {category.skills.map((skill) => {
                const skillLabel = t.skill_labels[skill.id as keyof typeof t.skill_labels] ?? skill.id;
                return (
                  <li class="skill-row">
                    <TechLogo id={skill.id} size={20} />
                    <span>{skillLabel}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
</section>
