---
import Icon from './Icon.astro';

interface Props {
  /** Matches the skill/tag id in data/portfolio.ts */
  id: string;
  size?: number;
  class?: string;
}

const { id, size = 32, class: className = '' } = Astro.props;

// Tag id → symbol id in LogoSprite; webgpu is the only custom icon (Icon.astro).
const SYMBOLS: Record<string, string> = {
  angular: 'angular',
  vuejs: 'vue',
  astro: 'astro',
  svelte: 'svelte',
  typescript: 'typescript',
  javascript: 'javascript',
  tailwindcss: 'tailwindcss',
  quasar: 'quasar',
  sass: 'sass',
  figma: 'figma',
  git: 'git',
  github: 'github',
  'azure-devops': 'azuredevops',
  supabase: 'supabase',
  'spring-boot': 'spring',
  pinia: 'pinia',
};

const symbol = SYMBOLS[id];
---

{
  id === 'webgpu' ? (
    <Icon name="webgpu" size={size} class={className} />
  ) : symbol ? (
    <svg width={size} height={size} class={className} aria-hidden="true" focusable="false">
      <use href={`#logo-${symbol}`} />
    </svg>
  ) : null
}
