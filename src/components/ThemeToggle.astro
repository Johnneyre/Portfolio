---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button id="theme-toggle" type="button" class="theme-btn" aria-label={label} title={label} aria-pressed="false">
  <!-- Shown in dark mode -->
  <svg
    id="icon-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z"></path>
  </svg>

  <!-- Shown in light mode -->
  <svg
    id="icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
    class="hidden"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
    ></path>
  </svg>
</button>

<script>
  const THEME_KEY = "theme";
  const LIGHT_CLASS = "light";
  const root = document.documentElement;

  const isLight = (): boolean => root.classList.contains(LIGHT_CLASS);

  function syncState(): void {
    const light = isLight();
    document.getElementById("icon-moon")?.classList.toggle("hidden", light);
    document.getElementById("icon-sun")?.classList.toggle("hidden", !light);
    document.getElementById("theme-toggle")?.setAttribute("aria-pressed", String(!light));
    document
      .querySelectorAll('meta[name="theme-color"]')
      .forEach((m) => m.setAttribute("content", light ? "#f7f8f9" : "#0e0f10"));
  }

  function toggleTheme(): void {
    root.classList.add("theme-transitioning");
    root.classList.toggle(LIGHT_CLASS);
    localStorage.setItem(THEME_KEY, isLight() ? "light" : "dark");
    syncState();
    setTimeout(() => root.classList.remove("theme-transitioning"), 300);
  }

  // Re-bind on first load and after every navigation (the button is swapped).
  document.addEventListener("astro:page-load", () => {
    syncState();
    document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
  });

  // Sync before the transition paints so the swapped button isn't stale.
  document.addEventListener("astro:after-swap", syncState);
</script>
