---
import "../styles/global.css";
import Header from "../components/Header.astro";
import LangHint from "../components/LangHint.astro";
import LogoSprite from "../components/LogoSprite.astro";
import SEO from "../components/SEO.astro";
import type { SupportedLocale } from "../i18n/utils";
import { useTranslations, sectionId } from "../i18n/utils";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";

interface Props {
  locale?: SupportedLocale;
}

const { locale = "es" } = Astro.props;
const t = useTranslations(locale);

const title = t.meta.title;
const description = t.meta.description;
---

<!doctype html>
<html lang={locale} id="html-root" class="hero-enter-on">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={t.owner.name} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta name="generator" content={Astro.generator} />

    <SEO locale={locale} />

    <ClientRouter fallback="none" />

    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-hanken" preload />

    <title>{title}</title>

    <!-- Inline on purpose: the theme must be set before first paint. -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        const applyTheme = () => {
          // html.js gates the scroll-reveal in global.css.
          root.classList.add("js");
          const stored = localStorage.getItem("theme");
          const light = stored
            ? stored === "light"
            : !window.matchMedia("(prefers-color-scheme: dark)").matches;
          root.classList.toggle("light", light);
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach((m) => m.setAttribute("content", light ? "#f7f8f9" : "#0e0f10"));
        };
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href={`#${sectionId(locale, "experience")}`}>{t.nav.skip}</a>

    <Header locale={locale} />
    <LangHint locale={locale} />

    <main>
      <slot />
    </main>

    <slot name="footer" />

    <LogoSprite />

    <script>
      let revealObserver: IntersectionObserver | null = null;
      let cueObserver: IntersectionObserver | null = null;

      function setupHeroCue() {
        cueObserver?.disconnect();
        const hero = document.querySelector(".hero");
        if (!hero) return;
        cueObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.classList.toggle("section-offscreen", !entry.isIntersecting);
            });
          },
          { rootMargin: "150px" },
        );
        cueObserver.observe(hero);
      }

      function setupReveal() {
        revealObserver?.disconnect();
        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                revealObserver?.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
        );
        document
          .querySelectorAll(".reveal:not(.is-visible)")
          .forEach((el) => revealObserver!.observe(el));
      }

      document.addEventListener("astro:page-load", () => {
        setupReveal();
        setupHeroCue();
      });

      // Strip the first-load flag from the incoming page so the hero entrance
      // doesn't replay over the view-transition crossfade.
      document.addEventListener("astro:before-swap", (event) => {
        (event as any).newDocument?.documentElement.classList.remove("hero-enter-on");
      });

      // After a locale swap, the crossfade is the only animation.
      document.addEventListener("astro:after-swap", () => {
        document.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-visible"));
      });
    </script>
  </body>
</html>
